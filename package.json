{
	"name": "joblist-atproto",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && node --test 'scripts/**/*.test.js' 'indexer/**/*.test.js' 'worker/**/*.test.js' 'bot/**/*.test.js'",
		"build:site": "node indexer/fetch-snapshot.js static/snapshot && vite build && node indexer/prerender.js build static/snapshot",
		"deploy": "npm run build:site && wrangler deploy",
		"import": "node scripts/import-joblist.js",
		"index": "node indexer/index.js static/snapshot",
		"prerender": "node indexer/prerender.js build static/snapshot",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@lucide/svelte": "^1.70.0",
		"@playwright/test": "^1.65.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^4.1.8",
		"wrangler": "^4.151.2"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@atproto/api": "^0.28.0",
		"@atproto/oauth-client-browser": "^0.5.10",
		"idb-keyval": "^6.3.0",
		"maplibre-gl": "^6.15.0"
	},
	"license": "GPL-3.0-or-later",
	"description": "Companies that hire, curated by people, on atproto"
}
