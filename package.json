{
	"name": "joblisttoday",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && node --test 'scripts/**/*.test.js' 'site/**/*.test.js'",
		"build:site": "npm run build:embed && vite build && node site/site.js build",
		"build:embed": "node scripts/build-embed.js",
		"test:e2e": "playwright test",
		"predev": "npm run build:embed"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@playwright/test": "^1.65.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^4.1.8"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@atproto/api": "^0.28.0",
		"@atproto/oauth-client-browser": "^0.5.10",
		"maplibre-gl": "^6.18.0"
	},
	"license": "GPL-3.0-or-later",
	"description": "Organizations describe themselves and post their jobs on atproto"
}
