{
	"$comment": "Social profiles an organization's website links to, recognized by host and path (a profile, not a share or login link). path: a regular expression on the link's path; its match is the profile's path.",
	"socials": [
		{ "id": "bluesky", "name": "Bluesky", "hosts": ["bsky.app"], "path": "^/profile/[^/]+" },
		{ "id": "mastodon", "name": "Mastodon", "hosts": ["mastodon.social", "mastodon.online", "fosstodon.org", "hachyderm.io", "mas.to", "social.coop"], "path": "^/@[^/]+" },
		{ "id": "linkedin", "name": "LinkedIn", "hosts": ["linkedin.com"], "path": "^/(company|school|showcase)/[^/]+" },
		{ "id": "instagram", "name": "Instagram", "hosts": ["instagram.com"], "path": "^/(?!p/|reel/|explore/|accounts/)[\\w.]+" },
		{ "id": "facebook", "name": "Facebook", "hosts": ["facebook.com", "fb.com"], "path": "^/(?!sharer|share|dialog|plugins|tr|login|groups/?$)[\\w.-]+(/[\\w.-]+)?" },
		{ "id": "x", "name": "X", "hosts": ["x.com", "twitter.com"], "path": "^/(?!intent|share|home|hashtag|i/|search)\\w+" },
		{ "id": "youtube", "name": "YouTube", "hosts": ["youtube.com"], "path": "^/(@[\\w.-]+|c/[^/]+|channel/[^/]+|user/[^/]+)" },
		{ "id": "tiktok", "name": "TikTok", "hosts": ["tiktok.com"], "path": "^/@[\\w.]+" },
		{ "id": "threads", "name": "Threads", "hosts": ["threads.net", "threads.com"], "path": "^/@[\\w.]+" },
		{ "id": "github", "name": "GitHub", "hosts": ["github.com"], "path": "^/(?!sponsors|features|login|about|pricing|topics|orgs/?$)[\\w.-]+" },
		{ "id": "gitlab", "name": "GitLab", "hosts": ["gitlab.com"], "path": "^/(?!users|explore|help)[\\w.-]+" },
		{ "id": "codeberg", "name": "Codeberg", "hosts": ["codeberg.org"], "path": "^/[\\w.-]+" },
		{ "id": "tangled", "name": "Tangled", "hosts": ["tangled.sh", "tangled.org"], "path": "^/@?[\\w.-]+" },
		{ "id": "discord", "name": "Discord", "hosts": ["discord.gg", "discord.com"], "path": "^/(invite/)?[\\w-]+" },
		{ "id": "telegram", "name": "Telegram", "hosts": ["t.me"], "path": "^/[\\w]+" }
	]
}
