{
	"name": "joblist",
	"url": "https://joblist.today",
	"source": "https://github.com/joblisttoday/joblist-atproto",
	"collections": {
		"company": "today.joblist.company",
		"list": "today.joblist.list",
		"job": "today.joblist.job",
		"suggestion": "today.joblist.suggestion"
	},
	"bots": [
		"did:plc:jqaucxlucukeif3bltpuc7zx"
	],
	"services": {
		"relay": "https://relay1.us-east.bsky.network",
		"appview": "https://public.api.bsky.app",
		"plc": "https://plc.directory",
		"handleResolver": "https://public.api.bsky.app"
	},
	"layout": {
		"wide": "(min-width: 64rem)",
		"dragThreshold": 6,
		"finePointer": "(hover: hover) and (pointer: fine)",
		"sheetPeekBelow": 0.3,
		"sheetFullAbove": 0.72
	},
	"map": {
		"style": "https://tiles.openfreemap.org/styles/positron",
		"styleDark": "https://tiles.openfreemap.org/styles/dark",
		"projection": "globe",
		"clusterRadius": 40,
		"clusterMaxZoom": 13,
		"nearZoom": 11,
		"selectZoom": 12,
		"globeSizePx": 320,
		"globeMinZoom": 1,
		"globeCenter": [10, 30],
		"globeSpan": 90,
		"frameDelayMs": 600,
		"center": [
			13.405,
			52.52
		],
		"zoom": 2,
		"maxZoom": 13,
		"padding": 40,
		"pointRadius": 6,
		"pointStroke": 2,
		"popupMax": 8,
		"placeMax": 500,
		"focus": { "cellDeg": 0.5, "km": 40, "share": 0.5 },
		"font": ["Noto Sans Regular"],
		"hitRadius": 22,
		"areaMinZoom": 4
	},
	"limits": {
		"concurrency": 6,
		"jobsConcurrency": 6,
		"pagesPerRepo": 100,
		"indexerConcurrency": 8,
		"boardPageSize": 100,
		"jobsPerBoard": 2000
	},
	"locales": [
		"en",
		"fr"
	],
	"defaultLocale": "en",
	"jobs": {
		"pageSize": 50,
		"placesSuggested": 30,
		"placesShown": 3,
		"nearbyShown": 5,
		"typingDelayMs": 200,
		"jobParam": "job",
		"remoteWords": [
			"remote",
			"anywhere",
			"home office",
			"homeoffice",
			"work from home",
			"wfh",
			"distributed",
			"télétravail",
			"teletravail",
			"fernarbeit",
			"mobiles arbeiten"
		]
	},
	"companies": {
		"pageSize": 100
	},
	"links": {
		"signup": "https://bsky.app",
		"profile": "https://bsky.app/profile/{handle}"
	},
	"analytics": {
		"script": "https://cloud.umami.is/script.js",
		"websiteId": "479fa5c4-e9c9-4d8d-85c6-9a88c886dd24",
		"domains": "joblist.today"
	},
	"geocode": {
		"service": "https://nominatim.openstreetmap.org/search",
		"userAgent": "joblist.today indexer (+https://joblist.today)",
		"delayMs": 1100,
		"officeBudget": 300,
		"officeCategories": ["office"],
		"officeMaxKm": 50,
		"budget": 1100,
		"tooWide": ["continent", "country", "state", "region", "province", "state_district", "county"],
		"cityCountries": ["singapore", "hong kong", "luxembourg", "monaco", "macao", "vatican city", "gibraltar"],
		"countryWords": ["usa", "us", "uk", "uae", "united states of america", "europe", "asia", "africa", "north america", "south america", "latin america"],
		"cityRegions": ["JP-13", "CN-SH", "CN-BJ", "CN-TJ", "CN-CQ"],
		"countryAliases": { "uk": "gb", "usa": "us", "united states": "us", "uae": "ae" },
		"placesFile": "places-2.json",
		"officesFile": "offices.json",
		"ignoreWords": ["hybrid", "on-site", "onsite", "on site", "office", "headquarters", "hq", "multiple locations", "various locations", "flexible", "friendly", "travel required", "jobs?", "global", "worldwide", "international", "distributed", "emea", "apac", "latam", "americas", "nordics", "dach", "benelux"]
	},
	"travel": {
		"kmPerHour": { "walk": 5, "bike": 15 },
		"mode": "bike",
		"detour": 1.3,
		"bandMinutes": 5,
		"minutes": [15, 30, 45, 60]
	},
	"snapshot": {
		"path": "https://raw.githubusercontent.com/joblisttoday/joblist-snapshot/gh-pages",
		"maxAgeHours": 12,
		"prerenderFiles": ["records.json", "jobs.json", "meta.json"]
	},
	"crawler": {
		"service": "https://bsky.social",
		"maxWritesPerRun": 200,
		"maxNewCompaniesPerRun": 25,
		"batchSize": 50,
		"pauseSeconds": 10,
		"concurrency": 8,
		"out": "static/snapshot/crawl",
		"openJobs": "https://raw.githubusercontent.com/elliottdehn/open-jobs/a6bb3ab9a96d87d02e4369cb97f55a8399e2d965/slugs.json",
		"search": {
			"service": "https://api.bsky.app",
			"queries": [
				"we're hiring",
				"we are hiring",
				"#hiring",
				"join our team",
				"open roles",
				"now hiring",
				"job opening",
				"come work with us"
			],
			"pages": 5
		}
	},
	"jobPost": {
		"days": 60,
		"maxDays": 120,
		"titleMax": 200,
		"descriptionMax": 10000,
		"page": "/job/{did}/{rkey}",
		"remote": [
			"onsite",
			"hybrid",
			"remote"
		],
		"employment": [
			"full-time",
			"part-time",
			"contract",
			"internship",
			"volunteer"
		],
		"schemaEmployment": {
			"full-time": "FULL_TIME",
			"part-time": "PART_TIME",
			"contract": "CONTRACTOR",
			"internship": "INTERN",
			"volunteer": "VOLUNTEER"
		}
	}
}
