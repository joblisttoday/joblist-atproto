{
	"name": "joblist",
	"url": "https://joblist.today",
	"source": "https://github.com/joblisttoday/joblisttoday.github.io",
	"collections": {
		"company": "today.joblist.company",
		"job": "today.joblist.job"
	},
	"lexicons": {
		"dir": "lexicons",
		"did": "did:plc:jqaucxlucukeif3bltpuc7zx",
		"permissionSet": "today.joblist.authFull"
	},
	"locales": [
		"en",
		"fr",
		"de",
		"es"
	],
	"defaultLocale": "en",
	"embed": {
		"page": "/embed",
		"scripts": "/embed/",
		"shown": 20
	},
	"analytics": {
		"script": "/vendor/umami.js",
		"hostUrl": "https://gateway.umami.is",
		"websiteId": "479fa5c4-e9c9-4d8d-85c6-9a88c886dd24",
		"domains": "joblist.today"
	},
	"services": {
		"appview": "https://public.api.bsky.app",
		"plc": "https://plc.directory",
		"handleResolver": "https://public.api.bsky.app",
		"dns": "https://cloudflare-dns.com/dns-query"
	},
	"links": {
		"signup": "https://bsky.app"
	},
	"jobPost": {
		"days": 30,
		"maxDays": 120,
		"dayChoices": [
			7,
			14,
			30,
			60,
			120
		],
		"titleMax": 200,
		"descriptionMax": 10000,
		"page": "/job/{did}/{rkey}",
		"remote": [
			"onsite",
			"hybrid",
			"remote"
		],
		"employment": [
			"full-time",
			"part-time",
			"contract",
			"internship",
			"volunteer"
		]
	},
	"limits": {
		"pagesPerRepo": 100
	},
	"shareImage": {
		"path": "/og.png",
		"width": 1200,
		"height": 630
	}
}
