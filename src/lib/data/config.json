{
	"name": "joblist",
	"url": "https://atproto.joblist.today",
	"source": "https://github.com/joblisttoday/joblist-atproto",
	"collections": {
		"company": "today.joblist.company",
		"list": "today.joblist.list",
		"job": "today.joblist.job",
		"suggestion": "today.joblist.suggestion"
	},
	"bots": [
		"did:plc:jqaucxlucukeif3bltpuc7zx"
	],
	"services": {
		"relay": "https://relay1.us-east.bsky.network",
		"appview": "https://public.api.bsky.app",
		"plc": "https://plc.directory",
		"handleResolver": "https://public.api.bsky.app"
	},
	"map": {
		"style": "https://tiles.openfreemap.org/styles/positron",
		"styleDark": "https://tiles.openfreemap.org/styles/dark",
		"center": [
			13.405,
			52.52
		],
		"zoom": 2,
		"maxZoom": 13,
		"padding": 40,
		"pointRadius": 6,
		"pointStroke": 2,
		"popupMax": 8
	},
	"limits": {
		"concurrency": 6,
		"jobsConcurrency": 6,
		"pagesPerRepo": 100,
		"indexerConcurrency": 8
	},
	"locales": [
		"en",
		"fr"
	],
	"defaultLocale": "en",
	"jobs": {
		"pageSize": 50,
		"placesSuggested": 30,
		"remoteWords": [
			"remote",
			"anywhere",
			"home office",
			"homeoffice",
			"work from home",
			"wfh",
			"distributed",
			"télétravail",
			"teletravail",
			"fernarbeit",
			"mobiles arbeiten"
		]
	},
	"companies": {
		"pageSize": 100
	},
	"links": {
		"signup": "https://bsky.app",
		"profile": "https://bsky.app/profile/{handle}"
	},
	"snapshot": {
		"path": "https://joblisttoday.github.io/joblist-snapshot",
		"maxAgeHours": 12
	},
	"crawler": {
		"service": "https://bsky.social",
		"maxWritesPerRun": 200,
		"maxNewCompaniesPerRun": 25,
		"batchSize": 50,
		"pauseSeconds": 10,
		"concurrency": 8,
		"out": "static/snapshot/crawl",
		"openJobs": "https://raw.githubusercontent.com/elliottdehn/open-jobs/a6bb3ab9a96d87d02e4369cb97f55a8399e2d965/slugs.json",
		"search": {
			"service": "https://api.bsky.app",
			"queries": [
				"we're hiring",
				"we are hiring",
				"#hiring",
				"join our team",
				"open roles",
				"now hiring",
				"job opening",
				"come work with us"
			],
			"pages": 5
		}
	},
	"jobPost": {
		"days": 60,
		"maxDays": 120,
		"titleMax": 200,
		"descriptionMax": 10000,
		"page": "/job/{did}/{rkey}",
		"remote": [
			"onsite",
			"hybrid",
			"remote"
		],
		"employment": [
			"full-time",
			"part-time",
			"contract",
			"internship",
			"volunteer"
		],
		"schemaEmployment": {
			"full-time": "FULL_TIME",
			"part-time": "PART_TIME",
			"contract": "CONTRACTOR",
			"internship": "INTERN",
			"volunteer": "VOLUNTEER"
		}
	}
}
