{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "joblist-atproto",
	"account_id": "561bb824be3c6da587401329eff1d81b",
	"compatibility_date": "2026-10-01",
	// A static site; the Worker only answers /api/* (featured jobs, see docs/revenue.md).
	"main": "src/worker/index.js",
	"assets": {
		"directory": "./build",
		"not_found_handling": "single-page-application",
		// Prerendered pages live at /path/index.html but are served at /path.
		"html_handling": "drop-trailing-slash",
		// Everything else is served as assets, without running the Worker.
		"run_worker_first": ["/api/*"]
	},
	"kv_namespaces": [
		{
			"binding": "FEATURED",
			// Created with `npx wrangler kv namespace create FEATURED`.
			// `wrangler dev` uses a local namespace and ignores it.
			"id": "69d46ba726414474b24e3e42a3371b94"
		}
	],
	// Secret (not in this file): STRIPE_WEBHOOK_SECRET, set with
	// `npx wrangler secret put STRIPE_WEBHOOK_SECRET`; locally in .dev.vars (not committed).
	"routes": [{ "pattern": "atproto.joblist.today", "custom_domain": true }]
}
