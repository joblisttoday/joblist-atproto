{
	"lexicon": 1,
	"id": "today.joblist.list",
	"description": "A list of companies curated by its author.",
	"defs": {
		"main": {
			"type": "record",
			"key": "tid",
			"record": {
				"type": "object",
				"required": ["name", "companies", "createdAt"],
				"properties": {
					"name": { "type": "string", "maxLength": 1000, "maxGraphemes": 100 },
					"description": { "type": "string", "maxLength": 30000, "maxGraphemes": 3000 },
					"companies": {
						"type": "array",
						"maxLength": 2000,
						"description": "Company record keys (domains), in the curator's order.",
						"items": { "type": "string", "maxLength": 512 }
					},
					"copiedFrom": { "type": "string", "format": "at-uri", "description": "The list this one was copied from." },
					"createdAt": { "type": "string", "format": "datetime" }
				}
			}
		}
	}
}
