{
	"manifest_version": 3,
	"name": "joblist",
	"version": "0.1.0",
	"description": "On any website: is this organization on joblist, does it hire, where is it on social networks. Keep it, tag it, in your browser only.",
	"homepage_url": "https://joblist.today",
	"icons": {
		"48": "icon.svg",
		"96": "icon.svg"
	},
	"action": {
		"default_popup": "popup.html",
		"default_title": "joblist",
		"default_icon": {
			"48": "icon.svg"
		}
	},
	"permissions": [
		"activeTab",
		"scripting",
		"storage"
	],
	"host_permissions": [
		"https://joblist.today/*"
	],
	"content_scripts": [
		{
			"matches": [
				"https://joblist.today/*",
				"http://127.0.0.1/*"
			],
			"js": [
				"sync.js"
			],
			"run_at": "document_idle"
		}
	],
	"browser_specific_settings": {
		"gecko": {
			"id": "addon@joblist.today",
			"strict_min_version": "128.0",
			"data_collection_permissions": {
				"required": [
					"none"
				]
			}
		}
	}
}
